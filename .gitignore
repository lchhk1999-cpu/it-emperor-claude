# Build output (regenerate with ./scripts/build.sh)
dist/

# Secrets / local config — never commit
.env
.env.*
*.pem
*.p12
*.mobileprovision
secrets/

# Real question-bank workbooks are delivered separately (docs/04)
data/question_bank/*.xlsx
data/question_bank/*.xls

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/
node_modules/

# Python caches (importer tests)
__pycache__/
*.pyc

# Style references may be third-party screenshots: keep them local only
assets/style_references/*
!assets/style_references/README.md

# Local preview config (session-specific paths)
.claude/launch.json

# Revision notes source (ChatGPT track) is delivered separately like the question bank
data/revision_notes/*.docx
